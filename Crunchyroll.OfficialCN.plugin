#!name = Crunchyroll 中文字幕
#!desc = 官方中文优先；缺少时可用 Google 或自行配置的 OpenAI 兼容接口翻译英文 ASS。机翻会向所选服务发送对白，失败时回退。大模型默认关闭，API Key 默认为空。测试版。
#!author = hqwuzhaoyi
#!homepage = https://github.com/hqwuzhaoyi/crunchyroll-loon
#!loon_version = 3.5.1(983)
#!date = 2026-10-20

[Argument]
machine_translation = switch,true,type=boolean,tag=英文机翻兜底,desc=将普通英文对白发送至所选翻译服务
source = select,"官方优先","始终机翻",type=string,tag=字幕来源,desc=始终机翻可用于检验英文字幕翻译
display = select,"仅中文","中英双语",type=string,tag=机翻字幕显示
engine = select,"Google","OpenAI兼容",type=string,tag=翻译服务,desc=大模型需要填写下方接口及模型配置
llm_base_url = input,"https://api.openai.com/v1",type=string,tag=大模型接口地址,desc=HTTPS Base URL 或完整 chat/completions 地址
llm_model = input,"",type=string,tag=大模型模型名,desc=填写接口支持的模型 ID
llm_api_key = input,"",type=string,tag=大模型 API Key,desc=由你填写并保存在 Loon 用户配置中，默认留空
llm_json_mode = switch,true,type=boolean,tag=大模型 JSON 模式,desc=不兼容 response_format 的服务可关闭，仍会校验译文 ID
llm_budget_seconds = input,15,type=number,tag=大模型等待上限（秒）,desc=5 到 40 秒，超时保留已完成译文

[Script]
response if ${url} ~= /^https:\/\/www\.crunchyroll\.com\/playback\/v3\/[^/?]+\/ios\/iphone\/play(?:\?|$)/i && ${request.method} == "GET" && ${response.status} == 200 then script("https://raw.githubusercontent.com/hqwuzhaoyi/crunchyroll-loon/v0.2.0-beta.2/Crunchyroll.OfficialCN.js", {${source}, ${machine_translation}}) with tag="Crunchyroll：官方中文字幕", requires_body=true, timeout=5
response if ${machine_translation} == true && ${url} ~= /^https:\/\/vod-fy-mod\.crunchyrollcdn\.com\/static\/[^?#]*\/subtitles\/enus\/[^?#]*\.ass(?:\?|$)/i && ${request.method} == "GET" && ${response.status} == 200 then script("https://raw.githubusercontent.com/hqwuzhaoyi/crunchyroll-loon/v0.2.0-beta.2/Crunchyroll.Translate.js", {${display}, ${engine}, ${llm_base_url}, ${llm_model}, ${llm_api_key}, ${llm_json_mode}, ${llm_budget_seconds}}) with tag="Crunchyroll：英文字幕机翻", requires_body=true, timeout=45

[Mitm]
hostname = www.crunchyroll.com, vod-fy-mod.crunchyrollcdn.com
